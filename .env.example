# Copy this file to .env and fill in the value. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# This project needs exactly one credential.

# Portkey gateway key. All five agents call gpt-6-luna through Portkey at
# https://api.portkey.ai/v1. No other model is used anywhere in this project.
PORTKEY_API_KEY=pk-your-portkey-key-here


# ---------------------------------------------------------------------------
# Optional, and it goes in frontend/.env, not here — Vite only reads env files
# from its own root. Where the React dashboard looks for the FastAPI backend.
# Leave it unset and the dashboard defaults to http://127.0.0.1:8000.
#
#   VITE_API_BASE=http://127.0.0.1:8000
